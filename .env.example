# ============================================================
# skillhubserver 环境变量示例 / Environment variables example
# ------------------------------------------------------------
# 复制为 .env 后按需修改：  cp .env.example .env
# Pydantic Settings 会自动从 .env 文件或系统环境变量读取。
# ============================================================

# ---- 服务 / Server ----
HOST=0.0.0.0
PORT=3000

# ---- 数据库 / Database ----
# DATABASE_TYPE 决定使用哪种数据库适配器：sqlite | postgresql
DATABASE_TYPE=sqlite

# SQLite（默认，单容器开箱即用）
DATABASE_URL=sqlite:///./data/db/skillhubserver.db
# PostgreSQL 示例（使用 asyncpg 驱动），启用时将上面一行注释掉并取消下行注释：
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/skillhub

# ---- 数据目录 / Data root ----
# 技能工作区、数据库文件、上传媒体的根目录
DATA_ROOT=./data

# ---- Session / 会话 ----
SESSION_MAX_AGE=604800          # 会话最长有效期，秒（7 天）
SESSION_IDLE_TIMEOUT=1800       # 空闲超时，秒（30 分钟）
SESSION_COOKIE_NAME=session_id  # 会话 Cookie 名称

# ---- 密钥 / Secret（必填 Required）----
# 用于 CSRF token 签名验证，必须设置为强随机值，切勿使用示例值或提交到版本库。
# 生成方式 / Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ---- 媒体 / Media ----
MAX_UPLOAD_SIZE=5242880         # 单文件上传上限，字节（5 MB）

# ---- 日志 / Logging ----
LOG_LEVEL=info                  # debug | info | warning | error
